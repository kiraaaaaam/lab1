<Window x:Class="Todolist.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Todo List" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen">
    
    <!-- Главная сетка размещает таблицу слева, а управление задачей — справа. -->
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <!-- Левая колонка: таблица задач, занимает свободное место. -->
            <ColumnDefinition Width="*"/>
            <!-- Разделитель -->
            <ColumnDefinition Width="15"/>
            <!-- Правая колонка: более узкая форма управления задачами. -->
            <ColumnDefinition Width="290"/>
        </Grid.ColumnDefinitions>

        <!-- Правая панель содержит поля редактирования и все действия с задачей. -->
        <Border Grid.Column="2" Background="#F8F9FA" Padding="15" CornerRadius="8" BorderBrush="#DEE2E6" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Управление задачей" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Foreground="#333333"/>

                <!-- Название -->
                <TextBlock Text="Заголовок задачи *:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtTitle" Height="30" Margin="0,0,0,10" Padding="5"/>

                <!-- Описание -->
                <TextBlock Text="Описание:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtDescription" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10" Padding="5"/>

                <!-- Срок выполнения (Дедлайн) -->
                <TextBlock Text="Дедлайн:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <DatePicker x:Name="dpDueDate" Height="30" Margin="0,0,0,10"/>

                <!-- Приоритет -->
                <TextBlock Text="Приоритет:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox x:Name="cbPriority" Height="30" Margin="0,0,0,10"/>

                <!-- Статус -->
                <TextBlock Text="Статус:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox x:Name="cbStatus" Height="30" Margin="0,0,0,15"/>

                <!-- Кнопки действий -->
                <Button x:Name="btnAdd" Content="➕ Добавить задачу" Height="35" Margin="0,0,0,5" 
                        Background="#28A745" Foreground="White" FontWeight="Bold" Click="BtnAdd_Click"/>
                
                <Button x:Name="btnUpdate" Content="✏️ Сохранить изменения" Height="35" Margin="0,0,0,5" 
                        Background="#007BFF" Foreground="White" FontWeight="Bold" Click="BtnUpdate_Click"/>
                
                <Button x:Name="btnClear" Content="Очистить форму" Height="30" Margin="0,0,0,15" Click="BtnClear_Click"/>

                <Button Content="🗑️ Удалить выбранную" Height="35" Margin="0,0,0,10"
                        Background="#DC3545" Foreground="White" FontWeight="Bold" Click="BtnDelete_Click"/>

                <Separator Margin="0,5,0,15"/>

                <!-- Кнопки сохранения и загрузки JSON -->
                <TextBlock Text="Файлы (JSON)" FontWeight="Bold" Margin="0,0,0,8" Foreground="#555555"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Сохранить 💾" Height="32" Click="BtnSave_Click"/>
                    <Button Grid.Column="2" Content="Загрузить 📂" Height="32" Click="BtnLoad_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Левая панель показывает список; выбранная строка заполняет форму справа. -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Список задач" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

            <!-- Колонки привязаны к свойствам TodoModel; таблица только для чтения,
                 редактирование выполняется через поля формы. -->
            <DataGrid x:Name="dgTasks" Grid.Row="1" AutoGenerateColumns="False" 
                      IsReadOnly="True" SelectionMode="Single"
                      SelectionChanged="DgTasks_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="150"/>
                    <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="180"/>
                    <DataGridTextColumn Header="Создано" Binding="{Binding CreatedAt, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" Width="120"/>
                    <DataGridTextColumn Header="Дедлайн" Binding="{Binding DueDate, StringFormat=\{0:dd.MM.yyyy\}}" Width="100"/>
                    <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority}" Width="90"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
